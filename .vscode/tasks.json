{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CarFox: start local server (8080)",
      "type": "shell",
      "command": "py -m http.server 8080",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "http-server",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^",
          "endsPattern": "Serving HTTP"
        }
      }
    }
  ]
}
